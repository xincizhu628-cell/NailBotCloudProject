NODE_ENV=production
PORT=4174
PUBLIC_BASE_URL=https://nailbotau.com

# Database
# Current local development uses data/nail_studio.db.
# For production, move to a managed database when ready and put the URL here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nailbot

# Static/user asset storage
ASSET_STORAGE_PROVIDER=r2
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nailbot-assets
R2_PUBLIC_BASE_URL=https://assets.nailbotau.com

# Square payment
SQUARE_ENV=production
SQUARE_APP_ID=
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_CURRENCY=AUD
SQUARE_COUNTRY=AU
SQUARE_VERSION=2026-05-20
SQUARE_WEBHOOK_SIGNATURE_KEY=

# AI generation providers
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_STEPS=4
HF_GUIDANCE=0

ARK_API_KEY=
ARK_IMAGE_ENDPOINT=https://ark.ap-southeast.bytepluses.com/api/v3/images/generations
ARK_IMAGE_MODEL=seedream-4-5-251128
ARK_GUIDANCE_SCALE=2.5
ARK_DESIGN_WIDTH=1536
ARK_DESIGN_HEIGHT=2560
ARK_PREVIEW_WIDTH=2048
ARK_PREVIEW_HEIGHT=2048

ARK_EDIT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_EDIT_API_KEY=
ARK_EDIT_MODEL=doubao-seededit-3-0-i2i-25062
ARK_EDIT_SIZE=adaptive
ARK_EDIT_RESPONSE_FORMAT=url
ARK_EDIT_GUIDANCE_SCALE=5.5
ARK_EDIT_SEED=-1
ARK_EDIT_WATERMARK=false

REPLICATE_API_TOKEN=
REPLICATE_PREVIEW_MODEL=
COZE_PREVIEW_ENDPOINT=
COZE_API_TOKEN=

# Login verification
SESSION_SECRET=replace_with_long_random_string
ADMIN_SESSION_SECRET=replace_with_another_long_random_string
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NailBot <no-reply@nailbotau.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
